# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smartcloud_vault

# JWT Configuration
SECRET_KEY=uHr-XMDLhWfTQleLAukWvCPtgi-qvj8Nbd9_mDd5vJs
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Configuration
UPLOAD_DIR=./storage/uploads
PROTECTED_DIR=./storage/protected
TEMP_DIR=./storage/temp

# =====================================
# AWS S3 Storage Configuration
# =====================================
# Set to 'true' to use AWS S3, 'false' for local file storage
USE_S3_STORAGE=true

# AWS Credentials (only required when USE_S3_STORAGE=true)
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# AWS Region where your S3 buckets are located
AWS_REGION=us-east-1

# S3 Bucket Names (must exist before starting the application)
S3_ORIGINAL_BUCKET=smartcloud-vault-original
S3_MASKED_BUCKET=smartcloud-vault-masked

# AI Models
SPACY_MODEL=en_core_web_sm
HUGGINGFACE_MODEL=dslim/bert-base-NER

# Application
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE=10485760
